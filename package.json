{
  "name": "dollartlbot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "npm run cf-typegen && tsc --noEmit",
    "test:admin-browser": "playwright test tests/admin-runtime.spec.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "prepare:vendor": "node scripts/prepare-vendor.mjs",
    "configure-bot": "node scripts/configure-bot.mjs",
    "discover-ids": "node scripts/discover-ids.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^24.0.0",
    "lucide": "1.27.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.0.0"
  }
}
