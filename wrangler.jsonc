{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dollartlbot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "node scripts/prepare-vendor.mjs"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "vars": {
    "BOOSTY_SUBSCRIPTION_URL": "https://boosty.to/domnekromanta/purchase/4041120?ssource=DIRECT&share=subscription_link",
    "MINI_APP_URL": "https://dollartlbot.sashahumortele2.workers.dev/app/?build=20260810-access2",
    "BOT_USERNAME": "dollartlbot"
  },
  "secrets": {
    "required": [
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_WEBHOOK_SECRET",
      "ADMIN_TELEGRAM_ID",
      "BOOSTY_GROUP_ID"
    ]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/webhook", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dollartlbot-db",
      "database_id": "419adace-0b70-42f4-b9c1-a298c92b6fd3"
    }
  ],
  "r2_buckets": [
    {
      "binding": "COVERS",
      "bucket_name": "dollartl-covers"
    }
  ]
}